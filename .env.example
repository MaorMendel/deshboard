# להעתיק לקובץ .env ולמלא. את .env לא מכניסים ל-git ולא שולחים לאף אחד.

# --- האתר ---
# הכתובת הציבורית של האתר. ממנה נבנים הקישורים האישיים (https://.../b/<key>).
APP_URL=http://localhost:3000

# --- DB (Supabase) ---
# Supabase -> Connect -> Direct -> Transaction pooler (פורט 6543). להחליף את [YOUR-PASSWORD] בסיסמה.
# סיסמה עם תווים מיוחדים ($ @ # / ?) שוברת את הכתובת. עדיף אותיות ומספרים בלבד.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# --- Vapi ---
# Vapi Dashboard -> API Keys -> Private Key. רק בשרת, אף פעם לא בדפדפן.
VAPI_PRIVATE_KEY=
# assistant משותף שעליו רצים כל הדמואים
VAPI_DEMO_ASSISTANT_ID=
# המספר שממנו יוצאות שיחות ניסיון של דמואים, ושל לקוחות בלי מספר משלהם.
# חייב להיות מספר שיכול להתקשר לישראל (Twilio, Vonage או SIP). מספרים חינמיים של Vapi לא מתקשרים לחו"ל.
VAPI_TEST_PHONE_NUMBER_ID=

# --- דוגמאות שמע לקולות ---
# לא חובה. בלעדיהם אפשר עדיין להעלות קובץ MP3 ידנית לכל קול במסך הקולות.
# Cartesia: play.cartesia.ai -> API Keys
CARTESIA_API_KEY=
# ElevenLabs: elevenlabs.io -> Developers -> API Keys (הרשאת Text to Speech מספיקה)
ELEVENLABS_API_KEY=

# --- פאנל הניהול ---
# הסיסמה לכניסה ל-/admin. לפחות 8 תווים.
ADMIN_PASSWORD=

# --- ה-API הפנימי, והצפנת הקישורים ---
# סוד ארוך ואקראי, לפחות 16 תווים. ליצירה: openssl rand -hex 32
# משמש גם להצפנת הקישורים כדי שאפשר יהיה להציג אותם שוב בפאנל. אם מחליפים אותו,
# קישורים קיימים ממשיכים לעבוד אבל לא יוצגו שוב בפאנל.
INTERNAL_API_SECRET=
